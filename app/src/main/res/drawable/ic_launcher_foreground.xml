<?xml version="1.0" encoding="utf-8"?>
<!--
    Primer plano del ícono: moneda dorada con $ y dos flechas de cambio.
    Todo cabe en la "zona segura" (círculo de radio 33 en el centro) para que
    ningún launcher lo recorte, sea cual sea la forma (círculo, cuadrado, gota…).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Al 88 %: así todo queda dentro de la zona segura (radio 33). -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.88"
        android:scaleY="0.88">

        <!-- Flechas de cambio -->
        <path
            android:pathData="M26.75,44.08 A29,29 0 0,1 79.9,41.6"
            android:strokeWidth="4"
            android:strokeColor="#FFFFFFFF"
            android:strokeLineCap="round" />
        <path
            android:pathData="M81.25,63.92 A29,29 0 0,1 28.1,66.4"
            android:strokeWidth="4"
            android:strokeColor="#FFFFFFFF"
            android:strokeLineCap="round" />
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M83.4,49.9 L85.6,38.6 L74.6,42.4 Z"
            android:strokeWidth="1.5"
            android:strokeColor="#FFFFFFFF"
            android:strokeLineJoin="round" />
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M24.6,58.1 L22.4,69.4 L33.4,65.6 Z"
            android:strokeWidth="1.5"
            android:strokeColor="#FFFFFFFF"
            android:strokeLineJoin="round" />

        <!-- Sombra suave de la moneda -->
        <path
            android:fillColor="#590B4430"
            android:pathData="M54,36.2 A19,19 0 1,1 54,74.2 A19,19 0 1,1 54,36.2 Z" />

        <!-- Moneda -->
        <path android:pathData="M54,35 A19,19 0 1,1 54,73 A19,19 0 1,1 54,35 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="42.6"
                    android:startY="38.8"
                    android:endX="65.4"
                    android:endY="69.2">
                    <item android:offset="0" android:color="#FFFFE082" />
                    <item android:offset="1" android:color="#FFF0A500" />
                </gradient>
            </aapt:attr>
        </path>
        <path
            android:pathData="M54,38.6 A15.4,15.4 0 1,1 54,69.4 A15.4,15.4 0 1,1 54,38.6 Z"
            android:strokeWidth="1.4"
            android:strokeColor="#FFC98A00" />

        <!-- Signo $ -->
        <path
            android:pathData="M59.6,47.6 C58.3,45.8 56.4,45.0 54.0,45.0 C50.6,45.0 48.6,46.9 48.6,49.4 C48.6,52.4 51.4,53.2 54.0,53.9 C57.0,54.7 59.6,55.7 59.6,58.7 C59.6,61.4 57.4,63.1 54.0,63.1 C51.2,63.1 49.0,62.1 47.8,60.2 M54,41.2 L54,45 M54,63.1 L54,66.8"
            android:strokeWidth="3.4"
            android:strokeColor="#FF00513A"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
